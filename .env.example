# 复制为 .env 并填写真实值（.env 不入库）
# 真实环境变量优先级高于本文件，容器部署时用平台注入即可

# ---- 大模型 API（DeepSeek，OpenAI 兼容协议）----
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 主模型限流/超时时降级用（留空 = 不降级）
LLM_FALLBACK_MODEL=

# ---- 本地令牌桶限流（保护自己，也保护上游配额）----
LLM_RATE_RPS=5
LLM_RATE_BURST=10

# ---- Embedding / Rerank（本地开源模型，HuggingFace 仓库名）----
# 实际生效值以 configs/settings.yaml 为准；
# 建索引时加 --hash-embed 可完全离线（不下载任何模型）
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- HuggingFace 下载镜像（国内加速，可选）----
HF_ENDPOINT=https://hf-mirror.com

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_DIR=logs
